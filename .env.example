# Get a Gemini API key from Google AI Studio and paste it here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=180
SPECTRE_DAILY_MODEL=gemini-3.5-flash-lite
SPECTRE_TTS_MODEL=gemini-3.8-flash-tts
SPECTRE_TTS_VOICE=Puck

# Optional: require --confirm-upload for every private YouTube upload.
REQUIRE_UPLOAD_CONFIRMATION=false
